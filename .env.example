# Copy this file to ".env" in the project root and paste your values.
# ".env" is gitignored. Requires: pip install -r requirements.txt (python-dotenv).

TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# --- IMDb Selenium (optional) ---
# Headless often gets blocked; visible Chrome usually works for Export/CSV.
# SELENIUM_HEADLESS=0
# IMDB_ALLOW_VISIBLE_FALLBACK=1
# SELENIUM_BROWSER=chrome
# IMDB_WATCHLIST_URL=https://www.imdb.com/user/YOUR_ID/watchlist/
# IMDB_USE_EXPORT_FLOW=1

# Skip TV/mini-series from IMDb CSV and drop IMDb-only TV from merged cache (movie-focused list).
# IMDB_WATCHLIST_MOVIES_ONLY=1
