# Copy this file to ".env" in the project root and paste your values.
# ".env" is gitignored. Requires: pip install -r requirements.txt (python-dotenv).

TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# OMDb (omdbapi.com) — recommended for IMDB_WATCHLIST_MOVIES_ONLY when IMDb is DOM-scraped (no CSV Title Type).
# Backfills each tt id so TV series can be dropped from the merged list. Or use data/omdb_api_key.txt (one line).
# OMDB_API_KEY=

# --- IMDb Selenium (optional) ---
# Default: headless only (no browser window). If IMDb often returns 0 titles in headless, set:
# IMDB_ALLOW_VISIBLE_FALLBACK=1
# Default is on: headless IMDb often returns 0 titles; one visible retry helps. Set to 0 to disable.
# (opens a visible Chrome window for one retry). Or use SELENIUM_HEADLESS=0 to always use a visible browser.
# SELENIUM_HEADLESS=0
# SELENIUM_BROWSER=chrome
# IMDB_WATCHLIST_URL=https://www.imdb.com/user/YOUR_ID/watchlist/
# IMDB_USE_EXPORT_FLOW=1
#
# Persistent Chrome profile (recommended when headless gets 0 titles / login walls):
# 1) Pick a dedicated folder (e.g. data/chrome_imdb_profile), not your daily Chrome user data.
# 2) Once: SELENIUM_HEADLESS=0 and SELENIUM_CHROME_USER_DATA_DIR=... then run refresh; log into IMDb in the window.
# 3) Then SELENIUM_HEADLESS=1 with the same SELENIUM_CHROME_USER_DATA_DIR so headless reuses cookies.
# SELENIUM_CHROME_USER_DATA_DIR=data/chrome_imdb_profile
# SELENIUM_CHROME_PROFILE_DIRECTORY=Default
# SELENIUM_CHROME_LANG=en-US
#
# If IMDb still returns 0 titles, set this to a folder to save imdb_watchlist_debug.html (page source + log line with title/URL).
# SELENIUM_DEBUG_HTML_DIR=data

# Skip TV/mini-series from IMDb CSV and drop IMDb-only TV from merged cache (movie-focused list).
# IMDB_WATCHLIST_MOVIES_ONLY=1
